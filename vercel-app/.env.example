# Shared password gate for the private Vercel site. Set the same value in
# Vercel for Production, Preview and Development. Minimum 12 characters;
# the app and APIs fail closed without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SITE_PASSWORD=

# Signing secret for the short-lived demo tokens used by /api/analyze.
# Set the same value in Vercel for Production, Preview and Development.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum length is 32 characters; the API fails closed without it.
DEMO_SIGNING_SECRET=

# Optional limits (defaults shown). Set in Vercel only to override.
# DEMO_IP_REQUESTS_PER_10_MIN=12
# DEMO_IP_REQUESTS_PER_DAY=60
# DEMO_DAILY_REQUEST_CAP=200

# Google Sheet pitch log (optional). Create a service account in Google Cloud,
# share the sheet with its client_email as Editor, then set:
# SHEET_ID=<the long id from the sheet URL>
# SHEET_TAB=Pitches
# GOOGLE_SERVICE_ACCOUNT_JSON=<entire one-line service-account JSON>
# SHEET_ID=
# SHEET_TAB=
# GOOGLE_SERVICE_ACCOUNT_JSON=
